<?xml version="1.0" encoding="utf-8"?>
<!-- #19: Android 12 and newer (android:dataExtractionRules). Include-only, for
     both Google cloud backup and device-to-device transfer: just the household
     file. Sign-in details and the database never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="household_backup.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="household_backup.json" />
    </device-transfer>
</data-extraction-rules>
